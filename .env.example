# MECH & DIE - Email Configuration (Nodemailer)
# Configure these variables in your deployment environment (e.g., Vercel, Hostinger, cPanel)
# or in .env.local for local testing.

# Destination email where inquiries are sent
CONTACT_RECIPIENT_EMAIL=info@mechanddie.com

# SMTP Server Details
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-specific-password
SMTP_FROM="MECH & DIE Website" <no-reply@mechanddie.com>
